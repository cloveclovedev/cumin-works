@startuml poll-snapshot
' cumin works - what the two queries of a poll read: nested connections and their limits.
' Document: poll.md, section on what a poll reads.
' Render: run scripts/render-diagrams.sh at the root of the repository.
skinparam shadowing false
skinparam defaultFontName sans-serif

package "Query 1: the poll query (each page of 10 requirement issues)" {
  object "repository" as repo
  object "requirement issue (open, cumin/type/requirement)\nnumber, state, labels (up to 100)" as req
  object "sub-issue (implementation issue)\nnumber, id, title, state, closedAt, labels (up to 100)" as sub
  object "blocked-by issue\nnumber, state" as blocker
}
package "Query 2: the pull requests of the selected sub-issues (up to 100 ids in one call)" {
  object "selected sub-issue\nopen, with a cumin/status/* label\nnamed by its id" as selected
  object "open pull request that closes the issue\nnumber, author, head commit, branch, mergeable\nlabels (up to 100), check results (up to 100)\nreviews (up to 100)" as pr
  object "head commit\noid, committedDate" as commit
}

repo "1" --> "10 per page" req : issues
req "1" --> "up to 15" sub : subIssues
sub "1" --> "up to 100" blocker : blockedBy
sub ..> selected : the selection (pure function)\nno selected sub-issue: no query 2
selected "1" --> "up to 2" pr : closedByPullRequestsReferences
pr "1" --> "last 1" commit : commits

note bottom of pr
  Closed and merged pull requests are not read here.
  I9 (follow-up note) reads merged pull requests separately.
end note
note left of sub
  The time that cumin/status/awaiting-checks
  was last added comes from the label times
  query, not from this query.
end note
note right of sub
  When an issue exceeds a limit
  of either query,
  the poll of that repository stops
  with an error that names the issue.
end note
@enduml
