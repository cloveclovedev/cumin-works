@startuml poll-split
' cumin works - the way out of cumin/status/planning: the decision that a poll and the end of a Planner run share, the second request of the split, and the way back to the Owner.
' Document: poll.md, sections on the decision of the poll and on the end of a run.
' Render: run scripts/render-diagrams.sh at the root of the repository.
skinparam shadowing false
skinparam defaultFontName sans-serif

start
if (Who decides?) then (the end of a Planner run of a split)
  if (Result?) then (blocked)
    :Read the requirement issue again;
    if (The read failed with
    a temporary failure?) then (yes)
      :Log only. The label stays.
      The next poll decides;
      stop
    else (no)
    endif
    :Comment blocked_reason, change the label to
    cumin/status/awaiting-decision, notify the Owner;
    stop
  else (done, or abnormal end)
    :Read the requirement issue again
    (one issue with its sub-issues);
  endif
else (a poll)
  if (The Planner of the issue runs?) then (yes)
    :Change nothing;
    stop
  else (no)
  endif
endif
:Read the time of cumin/status/planning,
and the comments since that time;
if (A read failed?) then (yes)
  :Change nothing.
  The next poll decides;
  stop
else (no)
endif
partition "Decision (pure function SplitEnd, no I/O)" {
  if (A question of the Planner
  after the label?) then (yes)
    :stop the split (question);
  elseif (One or more sub-issues, and exactly one
  risk label on every sub-issue?) then (yes)
    if (An open sub-issue?) then (yes)
      :ask the Owner to review the plan;
    else (no)
      :request the acceptance check;
    endif
  elseif (The split was already requested again
  in this stay? (state file)) then (yes)
    :stop the split (failed check);
  else (no)
    :request the split again;
  endif
}
switch (Action?)
case (review the plan)
  :Change the label to
  cumin/status/awaiting-plan-review;
  :Notify the Owner
  (the split needs a review);
case (acceptance check)
  :Change the label to
  cumin/status/accepting;
  :Request the acceptance check.
  No notification;
case (split again)
  :Count the request
  in the state file;
  :Request the split again
  (the label stays);
case (stop the split)
  :Change the label to
  cumin/status/awaiting-decision;
  :Comment the failed check
  (not after a question);
  :Notify the Owner;
endswitch
stop
@enduml
