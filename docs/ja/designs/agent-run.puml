@startuml agent-run
skinparam shadowing false
skinparam defaultFontName sans-serif

participant "cumin run\n(cmd/cumin)" as run
participant "cumin\n(internal/agent)" as cumin
participant "GitHub" as github
participant "Claude Code\n(claude -p)" as claude

run -> run : at start, write the skills of each role (again every time)\n$HOME/.local/state/cumin/skills/<role>/.claude/skills/<name>/SKILL.md\n(the body is a template of templates/)
note right of run : cumin-pull-request, cumin-review-reply,\ncumin-decision-request
run -> cumin : request (with the skill directory of the role)

cumin -> claude : minimal run (in an empty temporary directory)\nread the usage
claude --> cumin : rate_limit_event
note right of cumin : stop here when it cannot be read

cumin -> github : create the token of the role's App\n(the target repository only)
github --> cumin : installation token
cumin -> github : bot identity (once for each role)\nGET /app, GET /users/<slug>[bot]
github --> cumin : slug, user id

cumin -> claude : start (in the worktree, token and author in the environment)\nrole instruction (--append-system-prompt), schema,\nrequest (the facts of the run first: time limit, end time),\nskill directory of the role (--add-dir),\nnew session or --resume
activate claude
claude --> cumin : system / init\n(session ID, plugins, mcp_servers, memory_paths, skills)
cumin -> cumin : check the start record\n(stop at once on context from outside the work directory,\nor on a missing cumin skill)
claude -> claude : work. Invoke a skill right before the action\nand read SKILL.md (the template)\nexample: cumin-pull-request before gh pr create
claude --> cumin : rate_limit_event\n(usage and reset time)
claude --> cumin : assistant, user, ...\n(skipped)
claude --> cumin : result\n(structured_output, is_error)
deactivate claude
cumin -> cumin : check the exit code, the result,\nthe schema, and blocked_reason
alt normal end
  cumin -> cumin : return the session ID, the result, the usage
else abnormal end
  cumin -> cumin : return it with its kind\n(another part decides the retry)
end
@enduml
